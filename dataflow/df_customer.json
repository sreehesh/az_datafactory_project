{
	"name": "df_customer",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "src_ds_customer_data_input",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "snk_customer_op",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "dcCreateDateTime"
				}
			],
			"scriptLines": [
				"source(output(",
				"          customer_id as string,",
				"          { name} as string,",
				"          { age} as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source1 derive(dc_createDatetime = currentDate(),",
				"          dcCreateBy = \"sree\") ~> dcCreateDateTime",
				"dcCreateDateTime sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     mapColumn(",
				"          customer_id,",
				"          { name},",
				"          { age},",
				"          dc_createDatetime,",
				"          dcCreateBy",
				"     )) ~> sink1"
			]
		}
	}
}